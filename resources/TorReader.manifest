<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- LUOT 28 (Thu B): heapType SegmentHeap. Git dung asInvoker nhu manifest MSVC
     tu sinh truoc day (do bang mt.exe 29/09: exe cu chi co trustInfo).
     Nhap duoc: may do loader DA bao heapType=2 (SegmentHeap) cho MOI process,
     ke ca powershell.exe - xem rr_bench_base.txt. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>
</assembly>
