// TorReader Windows Resources
// App manifest and version info

#include <windows.h>

// Exe icon (Explorer + taskbar). Restored 2026-07-04 from torreader.cloud favicon04.ico.
IDI_ICON1 ICON "icons/TorReader.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,2,0,0
PRODUCTVERSION 2,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "B&B Creations"
            VALUE "FileDescription", "TorReader PDF Viewer"
            VALUE "FileVersion", "2.2.0.0"
            VALUE "InternalName", "TorReader"
            VALUE "LegalCopyright", "Copyright 2024-2026 B&B Creations"
            VALUE "OriginalFilename", "TorReader.exe"
            VALUE "ProductName", "TorReader"
            VALUE "ProductVersion", "2.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
